map $http_x_forwarded_proto $klaxond_forwarded_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}

map $http_x_forwarded_port $klaxond_forwarded_port {
  default $http_x_forwarded_port;
  "" $server_port;
}

map $http_host $klaxond_forwarded_host {
  default $http_host;
  "" $host;
}

server {
  listen 8080;
  server_name _;
  absolute_redirect off;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size ${KLAXOND_FRONTEND_MAX_BODY_SIZE};

  proxy_http_version 1.1;
  proxy_set_header Host $klaxond_forwarded_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $klaxond_forwarded_proto;
  proxy_set_header X-Forwarded-Host $klaxond_forwarded_host;
  proxy_set_header X-Forwarded-Port $klaxond_forwarded_port;

  location = /healthz {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location = /metrics {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location = /openapi.yaml {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location = /api/openapi.yaml {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location ~ ^/(api|auth)(/|$) {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location ~ ^/(webhook|beszel|healthchecks|wud|authentik|shelfmark|prowlarr|decypharr|pve)(/|$) {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location ~ ^/img/ {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location ~ ^/(swagger|api/docs|api/swagger|api/swagger-ui)(/|$) {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  # meta.js is generated by the backend so a split frontend reports the real
  # backend version and author metadata.
  location = /ui/meta.js {
    proxy_pass ${KLAXOND_BACKEND_URL};
  }

  location = /ui {
    return 302 /status;
  }

  location = /ui/ {
    return 302 /status;
  }

  location = /ui/index.html {
    return 302 /status;
  }

  location ~ ^/ui/(privacy|accessibility|terms|cookies)/?$ {
    return 302 /legal/$1;
  }

  location = /ui/legal {
    return 302 /legal/notice;
  }

  location = /ui/legal/ {
    return 302 /legal/notice;
  }

  location = /ui/auth {
    return 302 /authentication;
  }

  location = /ui/auth/ {
    return 302 /authentication;
  }

  location ~ ^/ui/(status|flow|inhibitions|deliveries|logs|audit|setup|render|routing|cascade|delivery|grouping|preview|simulator|test)/?$ {
    return 302 /$1;
  }

  location /ui/ {
    alias /usr/share/nginx/html/;
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
