# klaxond compose env vars. Every application setting here has a TOML/JSON
# equivalent; env vars remain useful when compose or a secret manager should
# override file-based settings at runtime.

# === Required for tier-1 ntfy delivery ===
NTFY_URL=https://push.example.com
NTFY_TOKEN_INFO=tk_xxx
NTFY_TOKEN_WARN=tk_xxx
NTFY_TOKEN_CRIT=tk_xxx
TOPIC_INFO=xxx
TOPIC_WARN=xxx
TOPIC_CRIT=xxx

# === Required if cascade tier-2 (Telegram) is enabled ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=

# === Required if cascade tier-3 (SMTP) is enabled ===
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# === Render attachments / public callbacks ===
GRAFANA_BASE=https://grafana.example.com
GRAFANA_RENDER_BASE=
GRAFANA_RENDER_TOKEN=
RENDER_IMAGE_TTL=900
KLAXOND_PUBLIC_URL=http://localhost:8181
ACK_DEFAULT_TTL_SECONDS=3600

# === Authentication bootstrap / secrets ===
AUTH_SESSION_SECRET=
AUTH_OIDC_CLIENT_SECRET=
AUTH_BASIC_PASSWORD_HASH=

# === Inbound webhook shared secrets ===
KLAXOND_INGEST_SECRET_GRAFANA=
KLAXOND_INGEST_SECRET_BESZEL=
KLAXOND_INGEST_SECRET_HEALTHCHECKS=
KLAXOND_INGEST_SECRET_WUD=
KLAXOND_INGEST_SECRET_AUTHENTIK=
KLAXOND_INGEST_SECRET_SHELFMARK=
KLAXOND_INGEST_SECRET_PROWLARR=
KLAXOND_INGEST_SECRET_DECYPHARR=

# === Runtime/path overrides ===
PORT=8181
KLAXOND_CONFIG=/data/klaxond.toml
RENDER_CONFIG_PATH=/data/render-config.json
NTFY_TOPICS_PATH=/data/ntfy-topics.json
DEDUP_CONFIG_PATH=/data/dedup-config.json
AUTH_CONFIG_PATH=/data/auth-config.json
AUTH_SESSION_KEY_PATH=/data/auth-session.key
KLAXOND_BACKUP_DIR=/data/backups
DEDUP_PENDING_DIR=/data/dedup_pending
BESZEL_DB_PATH=/beszel_data/data.db

# === Split frontend/backend/state compose ===
KLAXOND_BACKEND_IMAGE=git.luigibarretta.com/luigibarretta/klaxond:0.14
KLAXOND_BACKEND_CONTAINER=klaxond-backend
KLAXOND_BACKEND_BIND=8181
KLAXOND_FRONTEND_IMAGE=git.luigibarretta.com/luigibarretta/klaxond-frontend:0.14
KLAXOND_FRONTEND_CONTAINER=klaxond-frontend
KLAXOND_FRONTEND_BIND=8080
KLAXOND_FRONTEND_MAX_BODY_SIZE=25m
KLAXOND_BACKEND_URL=http://klaxond-backend:8181
KLAXOND_STATE_IMAGE=alpine:3.23
KLAXOND_STATE_CONTAINER=klaxond-state
KLAXOND_DATA_VOLUME=klaxond-data

# === Optional legacy overrides ===
# CASCADE_ENABLED=false       # for /webhook/* (Beszel always uses cascade)
