# klaxond env vars (only secrets/site-specific). Everything else lives in
# klaxond.toml — which bootstraps from the bundled default on first run.

# === Required for tier-1 ntfy delivery ===
NTFY_URL=https://push.example.com
NTFY_TOKEN_INFO=tk_xxx
NTFY_TOKEN_WARN=tk_xxx
NTFY_TOKEN_CRIT=tk_xxx
TOPIC_INFO=xxx
TOPIC_WARN=xxx
TOPIC_CRIT=xxx

# === Required if cascade tier-2 (Telegram) is enabled ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Required if cascade tier-3 (SMTP) is enabled ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# === Optional ===
# CASCADE_ENABLED=false       # for /webhook/* (Beszel always uses cascade)
# GRAFANA_BASE=https://grafana.example.com
