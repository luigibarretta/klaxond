# klaxond compose env vars. Every application setting here has a TOML/JSON
# equivalent; env vars remain useful when compose or a secret manager should
# override file-based settings at runtime.

# === Required for tier-1 ntfy delivery ===
NTFY_URL=https://push.example.com
NTFY_TOKEN_INFO=tk_xxx
NTFY_TOKEN_WARN=tk_xxx
NTFY_TOKEN_CRIT=tk_xxx
TOPIC_INFO=xxx
TOPIC_WARN=xxx
TOPIC_CRIT=xxx

# === Durable emergency receipts (Pushover-style retry until ACK) ===
# Disabled in the portable example; enable deliberately after configuring the
# public callback URL, persistent history and at least one fallback channel.
KLAXOND_EMERGENCY_ENABLED=false
KLAXOND_EMERGENCY_ALLOW_INSECURE_PUBLIC_URL=false
KLAXOND_EMERGENCY_ALLOW_NTFY_ONLY=false
KLAXOND_EMERGENCY_SEVERITIES=critical
KLAXOND_EMERGENCY_RETRY_SECONDS=60
KLAXOND_EMERGENCY_EXPIRE_SECONDS=3600
KLAXOND_EMERGENCY_MAX_ATTEMPTS=50
KLAXOND_EMERGENCY_LEASE_SECONDS=60
KLAXOND_EMERGENCY_TELEGRAM_AFTER_ATTEMPTS=3
KLAXOND_EMERGENCY_SMTP_AFTER_ATTEMPTS=5
KLAXOND_EMERGENCY_NOTIFY_ON_EXPIRY=true
KLAXOND_EMERGENCY_AUTO_RESOLVE=true
KLAXOND_EMERGENCY_EXCLUDE_SOURCES=api-test

# === Required if cascade tier-2 (Telegram) is enabled ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=

# === Required if cascade tier-3 (SMTP) is enabled ===
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# === Render attachments / public callbacks ===
GRAFANA_BASE=https://grafana.example.com
GRAFANA_RENDER_BASE=
GRAFANA_RENDER_TOKEN=
RENDER_IMAGE_TTL=900
# Optional action-button roots. Incoming payload URLs take precedence.
KLAXOND_SOURCE_URL_UPTIME_KUMA=
KLAXOND_SOURCE_URL_HEALTHCHECKS=
KLAXOND_SOURCE_URL_WUD=
KLAXOND_SOURCE_URL_PVE=
KLAXOND_SOURCE_URL_SHELFMARK=
KLAXOND_SOURCE_URL_PROWLARR=
KLAXOND_SOURCE_URL_DECYPHARR=
KLAXOND_PUBLIC_URL=http://localhost:8181
ACK_DEFAULT_TTL_SECONDS=3600

# === Authentication bootstrap / secrets ===
AUTH_SESSION_SECRET=
AUTH_OIDC_CLIENT_SECRET=
AUTH_BASIC_PASSWORD_HASH=
# Comma-separated reverse-proxy CIDRs, for example 192.0.2.10/32.
AUTH_TRUSTED_PROXY_CIDRS=

# === Inbound webhook shared secrets ===
KLAXOND_INGEST_SECRET_GRAFANA=
KLAXOND_INGEST_SECRET_BESZEL=
KLAXOND_INGEST_SECRET_HEALTHCHECKS=
KLAXOND_INGEST_SECRET_UPTIME_KUMA=
KLAXOND_INGEST_SECRET_WUD=
KLAXOND_INGEST_SECRET_AUTHENTIK=
KLAXOND_INGEST_SECRET_SHELFMARK=
KLAXOND_INGEST_SECRET_PROWLARR=
KLAXOND_INGEST_SECRET_DECYPHARR=
KLAXOND_INGEST_SECRET_PVE=
KLAXOND_INGEST_SECRET_BLACKSTART=
KLAXOND_INGEST_SECRET_GITHUB=

# === Runtime/path overrides ===
# Host bind for the monolithic Compose service. Keep loopback until auth and a
# reviewed HTTPS reverse proxy are configured.
KLAXOND_BIND=127.0.0.1:8181
PORT=8181
KLAXOND_CONFIG=/data/klaxond.toml
RENDER_CONFIG_PATH=/data/render-config.json
NTFY_TOPICS_PATH=/data/ntfy-topics.json
DEDUP_CONFIG_PATH=/data/dedup-config.json
AUTH_CONFIG_PATH=/data/auth-config.json
AUTH_SESSION_KEY_PATH=/data/auth-session.key
KLAXOND_BACKUP_DIR=/data/backups
DEDUP_PENDING_DIR=/data/dedup_pending
BESZEL_DB_PATH=/beszel_data/data.db
KLAXOND_SQLITE_PATH=/data/klaxond.db

# === Persistent delivery history ===
KLAXOND_HISTORY_BACKEND=sqlite
KLAXOND_POSTGRES_URL=
KLAXOND_HISTORY_RETENTION=5000
KLAXOND_HISTORY_DEFAULT_LIMIT=500
KLAXOND_POSTGRES_IMAGE=postgres:17-alpine
KLAXOND_POSTGRES_CONTAINER=klaxond-postgres
KLAXOND_POSTGRES_BIND=127.0.0.1:55432
KLAXOND_POSTGRES_DB=klaxond
KLAXOND_POSTGRES_USER=klaxond
KLAXOND_POSTGRES_PASSWORD=
KLAXOND_POSTGRES_VOLUME=klaxond-postgres-data

# === Split frontend/backend/state compose ===
KLAXOND_IMAGE=ghcr.io/luigibarretta/klaxond:0.18.0
KLAXOND_BACKEND_IMAGE=ghcr.io/luigibarretta/klaxond:0.18.0
KLAXOND_BACKEND_CONTAINER=klaxond-backend
KLAXOND_BACKEND_BIND=127.0.0.1:8181
KLAXOND_FRONTEND_IMAGE=ghcr.io/luigibarretta/klaxond-frontend:0.18.0
KLAXOND_FRONTEND_CONTAINER=klaxond-frontend
KLAXOND_FRONTEND_BIND=127.0.0.1:8080
KLAXOND_FRONTEND_MAX_BODY_SIZE=25m
KLAXOND_BACKEND_URL=http://klaxond-backend:8181
KLAXOND_STATE_IMAGE=alpine:3.23
KLAXOND_STATE_CONTAINER=klaxond-state
KLAXOND_DATA_VOLUME=klaxond-data

# === Optional legacy overrides ===
# CASCADE_ENABLED=false       # for /webhook/* (Beszel always uses cascade)
